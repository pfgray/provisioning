#!/usr/bin/env bash
# git-checkout-recent: fuzzy-select a recently checked-out branch and check it out

set -euo pipefail

selected=$(
  git reflog \
    | grep -o 'checkout: moving from .* to .*' \
    | awk '{print $NF}' \
    | awk '!seen[$0]++' \
    | head -20 \
    | while IFS= read -r branch; do
        hash=$(git rev-parse --short "$branch" 2>/dev/null) || hash="???"
        printf '%-40s %s\n' "$branch" "$hash"
      done \
    | fzf --prompt="Select branch to checkout: " \
          --no-sort \
          --layout=reverse \
          --height=~50%
)

branch=$(awk '{print $1}' <<< "$selected")

if [[ -n "$branch" ]]; then
  git checkout "$branch"
fi
